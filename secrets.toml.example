# Kopie davon als Inhalt in Streamlit Cloud → App → Settings → Secrets einfügen.
# Diese Datei NIE mit echten Werten ins Repo committen.

APP_PASSWORT = "hier-ein-sicheres-passwort"
START_NR = 1024            # nächste freie Rechnungsnummer, falls noch kein Journal existiert

[firma]
name    = "Firmenname"               # exakt wie im Handelsregister / UID-Register
strasse = "Strasse Nr."
plz_ort = "PLZ Ort"
telefon = "000 000 00 00"
uid     = "CHE-000.000.000"
mwst_nr = ""                         # leer = nicht MWST-pflichtig; sonst z.B. "CHE-000.000.000 MWST"
iban    = "CH00 0000 0000 0000 0000 0"
bank    = "Bankname"

[empfaenger]
name    = "Vorname Name"
strasse = "Strasse Nr."
plz_ort = "PLZ Ort"

[objekt]
text      = "Einfamilienhaus Neubau, Strasse Nr., PLZ Ort"
grundlage = "Mängelliste / Kostenschätzung Schwaller Architekturbüro vom 04.07.2026"

[github]                             # optional: Ablage jeder Rechnung in einem PRIVATEN Daten-Repo
token  = "github_pat_..."            # Fine-grained Token, nur das Daten-Repo, Contents: Read and write
repo   = "BENUTZERNAME/hausbau-rechnungen-daten"   # privates Repo, NICHT das App-Repo
branch = "rechnungen"                # eigener Branch → App startet beim Speichern nicht neu

[mail]                               # optional: Versand per E-Mail
host     = "smtp.gmail.com"
port     = 587
user     = "deine.adresse@gmail.com"
password = "app-passwort-16-zeichen" # Gmail → Google-Konto → Sicherheit → App-Passwörter
absender = "deine.adresse@gmail.com"
standard_empfaenger = "deine.adresse@gmail.com"
